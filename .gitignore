# --- Data -------------------------------------------------------------
# Nothing under data/ is committed. The synthetic sources are regenerable
# (`python -m src.generators.generate_all`) and the database is rebuilt from
# them, so there is no reason for either to be in history -- and this is the
# rule that keeps real experimental data out if this pipeline is ever pointed
# at a live run.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

*.db
*.sqlite
*.sqlite3

# --- Literature sub-project -------------------------------------------
# The entire tree stays out of version control. Publisher PDFs are licensed
# and this repo is public, so rather than relying on per-folder rules to keep
# documents out, nothing under literature/ is tracked at all.
#
# Extracted measurements are facts and will eventually flow into the public
# pipeline as literature-derived runs -- but they cross that boundary
# deliberately, through the ingestion layer, not by sitting in this repo.
literature/

# Belt and braces: no PDF anywhere in this repo, whatever the path.
*.pdf

# --- Private notes ----------------------------------------------------
# Claude Code's documented "local instructions" scope. Loads alongside
# CLAUDE.md automatically, so no import line is needed in the public file.
CLAUDE.local.md

# --- Secrets ----------------------------------------------------------
.streamlit/secrets.toml
secrets.toml
.env
.env.*
!.env.example
*.pem
*.key

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---------------------------------------------
.venv/
venv/
env/
ENV/

# --- Tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks --------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / OS -----------------------------------------------------
.DS_Store
.vscode/
.idea/
